# S3 compatible storage to archive podcast episodes
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET=...
# Assembly AI is used for transcription 
ASSEMBLYAI_API_KEY=...
# OpenRouter provides embeddings and LLMs
OPENROUTER_API_KEY=...
# (optional) Qdrant server as vector database
# if omitted: uses local database in data/qdrant
QDRANT_ENDPOINT_URL=https://your-cloud-instance-id.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
# (optional) Langfuse for tracing 
# if omitted: no tracing
LANGFUSE_BASE_URL=https://cloud.langfuse.com"
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
